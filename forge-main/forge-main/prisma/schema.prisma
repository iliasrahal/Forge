generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientType {
  PARTICULIER
  PROFESSIONNEL
}

enum InterventionStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
}

enum QuoteAcceptanceMethod {
  CLIENT_LINK
}

enum QuoteSignatureMethod {
  DRAWN
}

enum QuoteReminderChannel {
  EMAIL
}

enum InvoiceStatus {
  BROUILLON
  ENVOYEE
  PAYEE
  EN_RETARD
  ANNULEE
}

enum InvoiceType {
  STANDARD
  DEPOSIT
}

// Régime de TVA de l'organisation.
// SUBJECT : assujettie, elle facture la TVA.
// FRANCHISE_BASE : franchise en base (art. 293 B du CGI), aucune TVA facturée.
enum VatScheme {
  SUBJECT
  FRANCHISE_BASE
}

// Nature d'un document numéroté (compteur séquentiel séparé par nature).
enum DocumentKind {
  QUOTE
  INVOICE
  CREDIT_NOTE
}

enum ServicePricingType {
  FIXED
  HOURLY
  UNIT
}

enum UserJob {
  PLOMBIER_CHAUFFAGISTE
  ELECTRICIEN
  PEINTRE_BATIMENT
  MENUISIER
  AUTRE
}

enum WorkMode {
  SOLO
  TEAM
}

enum OrganizationType {
  PERSONAL
  TEAM
}

enum TeamRole {
  OWNER
  ADMIN
  READ_ONLY
  // Rôles historiques conservés tant que leur présence en production
  // n'a pas pu être auditée.
  MANAGER
  TECHNICIAN
}

enum StaffRole {
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id String @id @default(cuid())

  firstName String

  lastName String?

  companyName String?

  email String @unique

  emailVerifiedAt DateTime?

  phone String @unique

  passwordHash String

  trialStartedAt DateTime?

  trialEndsAt DateTime?

  subscriptionStatus String @default("TRIAL")

  job UserJob?

  workMode WorkMode?

  birthDate DateTime?

  onboardingCompleted Boolean @default(false)

  emailSignature String?

  themePreference String?

  // Forcé à true quand un admin plateforme attribue un mot de passe temporaire.
  mustChangePassword Boolean @default(false)

  clients Client[]

  interventions Intervention[]

  sessions Session[]

  passwordResetTokens PasswordResetToken[]

  accountActivationTokens AccountActivationToken[]

  memberships OrganizationMember[]

  personalOrganization Organization? @relation("PersonalOrganizationOwner")

  assignedInterventions Intervention[] @relation("AssignedInterventions")

  sentTeamInvitations TeamInvitation[] @relation("InvitationSender")

  staffMembership StaffMember?

  adminActions AdminAuditLog[] @relation("AdminAuditActor")

  quoteReminders QuoteReminder[] @relation("QuoteReminderCreator")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model StaffMember {
  id     String    @id @default(cuid())
  userId String    @unique
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   StaffRole @default(SUPPORT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  // Ex : "USER_PASSWORD_RESET_EMAIL", "USER_UPDATED", "USER_DELETED",
  // "SUBSCRIPTION_CHANGED", "STAFF_GRANTED", "USER_DATA_EXPORTED".
  action String

  targetType String
  targetId   String

  summary  String?
  metadata Json?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  type                OrganizationType     @default(TEAM)
  personalOwnerId     String?              @unique
  personalOwner       User?                @relation("PersonalOrganizationOwner", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  trialStartedAt      DateTime?
  trialEndsAt         DateTime?
  subscriptionStatus  String               @default("TRIAL")
  // Posé quand tous les membres d'une équipe sont FREE : l'équipe est
  // supprimée passé cette date. Remis à null dès qu'un membre a un abonnement.
  graceExpiresAt      DateTime?
  // Régime de TVA par défaut de l'espace + taux par défaut (points de base :
  // 2000 = 20 %, 1000 = 10 %, 550 = 5,5 %, 0 = 0 %). Surchargeable par document.
  vatScheme           VatScheme            @default(FRANCHISE_BASE)
  defaultVatRateBp    Int                  @default(2000)
  // Préfixes de numérotation. Numéro final : <préfixe><année>-<6 chiffres>,
  // ex. F2026-000042. Compteur remis à zéro chaque année.
  quotePrefix         String               @default("D")
  invoicePrefix       String               @default("F")
  creditNotePrefix    String               @default("AV")
  documentCounters    DocumentCounter[]
  members             OrganizationMember[]
  invitations         TeamInvitation[]
  clients             Client[]
  interventions       Intervention[]
  quotes              Quote[]
  invoices            Invoice[]
  serviceCatalogItems ServiceCatalogItem[]
  activeSessions      Session[]            @relation("ActiveOrganization")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ServiceCatalogItem {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  priceCents     Int
  pricingType    ServicePricingType
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId])
  @@index([organizationId, name])
}

// Compteur séquentiel de numéros de documents, par organisation, par nature
// et par année. `nextNumber` est le prochain numéro à attribuer.
model DocumentCounter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           DocumentKind
  year           Int
  nextNumber     Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, kind, year])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  role           TeamRole
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model TeamInvitation {
  id             String               @id @default(cuid())
  firstName      String?
  lastName       String?
  email          String
  role           TeamRole
  tokenHash      String               @unique
  expiresAt      DateTime
  status         TeamInvitationStatus @default(PENDING)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User                 @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Session {
  id String @id @default(cuid())

  token String @unique

  expiresAt DateTime

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  activeOrganization Organization? @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([activeOrganizationId])
}

model PasswordResetToken {
  id String @id @default(cuid())

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AccountActivationToken {
  id String @id @default(cuid())

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id String @id @default(cuid())

  type ClientType @default(PARTICULIER)

  firstName String?

  lastName String?

  companyName String?

  phone String?

  email String?

  street String?

  postalCode String?

  city String?

  notes String?

  // Client créé automatiquement par Forge lors d'une intervention
  // true = client temporaire
  // false = client enregistré normalement
  isTemporary Boolean @default(false)

  // Client masqué mais conservé pour l'historique
  // true = supprimé de l'affichage mais gardé en base
  archived Boolean @default(false)

  // Auteur historique conservé pour l'audit. Les données appartiennent à
  // l'organisation et survivent au départ d'un membre d'équipe.
  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  interventions Intervention[]

  quotes Quote[]

  invoices Invoice[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
}

model Intervention {
  id String @id @default(cuid())

  title String

  description String?

  // Date et heure de début prévue
  scheduledAt DateTime

  // Date de fin prévue (utile pour les chantiers longs)
  endDate DateTime?

  // Date réelle de début
  startedAt DateTime?

  // Date réelle de fin
  finishedAt DateTime?

  status InterventionStatus @default(PLANIFIEE)

  reportIntervention String?

  reportDiagnostic String?

  reportTravaux String?

  reportRecommendation String?

  invoices Invoice[]

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId String?

  assignedTo User? @relation("AssignedInterventions", fields: [assignedToId], references: [id], onDelete: SetNull)

  clientId String?

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([scheduledAt])
  @@index([endDate])
}

model Quote {
  id String @id @default(cuid())

  reference String @unique

  title String

  description String?

  // amountCents = total TTC (= total HT quand la TVA n'est pas applicable).
  amountCents Int @default(0)

  // TVA appliquée sur ce devis (surcharge le régime de l'organisation).
  vatApplicable Boolean @default(false)

  totalHtCents Int @default(0)

  totalVatCents Int @default(0)

  // Remise globale de pied de devis, en points de base (appliquée après les
  // remises de ligne, avant la TVA).
  discountBp Int @default(0)

  // Somme des déboursés secs des lignes (pour le calcul de marge).
  totalCostCents Int @default(0)

  status QuoteStatus @default(BROUILLON)

  acceptedAt DateTime?

  // Date du dernier envoi réussi du devis au client.
  sentAt DateTime?

  acceptanceMethod QuoteAcceptanceMethod?

  clientId String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  lines QuoteLine[]

  invoices Invoice[]

  publicAccesses QuotePublicAccess[]

  signature QuoteSignature?

  reminders QuoteReminder[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([organizationId])
}

model QuoteReminder {
  id String @id @default(cuid())

  quoteId String

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  sentAt DateTime

  channel QuoteReminderChannel @default(EMAIL)

  createdByUserId String?

  createdByUser User? @relation("QuoteReminderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([quoteId, sentAt])
  @@index([createdByUserId])
}

model QuotePublicAccess {
  id String @id @default(cuid())

  tokenHash String @unique

  quoteId String

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  signature QuoteSignature?

  revokedAt DateTime?

  acceptedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@index([quoteId, revokedAt])
}

model QuoteSignature {
  id String @id @default(cuid())

  quoteId String @unique

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  publicAccessId String @unique

  publicAccess QuotePublicAccess @relation(fields: [publicAccessId], references: [id], onDelete: Restrict)

  signerFirstName String

  signerLastName String

  method QuoteSignatureMethod @default(DRAWN)

  // V1 : traits manuscrits normalisés et limités. Un stockage objet pourra
  // remplacer cette représentation si Forge gère plus tard d'autres preuves.
  signatureData Json

  quoteSnapshot Json

  integrityHash String

  signedAt DateTime

  createdAt DateTime @default(now())

  @@index([signedAt])
}

model QuoteLine {
  id String @id @default(cuid())

  category String

  label String?

  // Quantité en milliunités (1000 = 1 ; 12500 = 12,5).
  quantityMilli Int @default(1000)

  // Unité affichée : "forfait", "h", "j", "m2", "m3", "ml", "u", "kg", "lot".
  unit String @default("forfait")

  // Prix unitaire HT en centimes.
  unitPriceCents Int @default(0)

  // Déboursé sec unitaire en centimes (coût). Null = marge non suivie.
  costCents Int?

  // Remise de ligne en points de base (500 = 5 %).
  discountBp Int @default(0)

  // Montant HT de la ligne, dénormalisé :
  // round(quantityMilli * unitPriceCents / 1000 * (10000 - discountBp) / 10000).
  amountCents Int @default(0)

  // Taux de TVA de la ligne en points de base (2000 = 20 %, 1000 = 10 %,
  // 550 = 5,5 %, 0 = 0 %). Ignoré si le devis n'applique pas la TVA.
  vatRateBp Int @default(0)

  quoteId String

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([quoteId])
}

model Invoice {
  id String @id @default(cuid())

  reference String @unique

  title String

  description String?

  // amountCents = total TTC (= total HT quand la TVA n'est pas applicable).
  amountCents Int @default(0)

  vatApplicable Boolean @default(false)

  totalHtCents Int @default(0)

  totalVatCents Int @default(0)

  // Remise globale de pied de facture, en points de base.
  discountBp Int @default(0)

  // Somme des déboursés secs des lignes (pour le calcul de marge).
  totalCostCents Int @default(0)

  lines InvoiceLine[]

  status InvoiceStatus @default(BROUILLON)

  // STANDARD pour les factures historiques/finales, DEPOSIT pour un acompte.
  type InvoiceType @default(STANDARD)

  dueDate DateTime?

  // Facture créée depuis un devis
  quoteId String?

  quote Quote? @relation(fields: [quoteId], references: [id])

  // Facture créée depuis une intervention terminée
  interventionId String?

  intervention Intervention? @relation(fields: [interventionId], references: [id])

  clientId String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([organizationId])
  @@index([quoteId])
  @@index([quoteId, type])
  @@index([interventionId])
}

model InvoiceLine {
  id String @id @default(cuid())

  category String

  label String?

  // Détail figé à la création de la facture.
  quantityMilli Int @default(1000)

  unit String @default("forfait")

  unitPriceCents Int @default(0)

  costCents Int?

  discountBp Int @default(0)

  // Montant HT de la ligne, figé à la création de la facture.
  amountCents Int @default(0)

  // Taux de TVA de la ligne en points de base. Ignoré si la facture
  // n'applique pas la TVA.
  vatRateBp Int @default(0)

  invoiceId String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}
