generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientType {
  PARTICULIER
  PROFESSIONNEL
}

enum InterventionStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
}

enum InvoiceStatus {
  BROUILLON
  ENVOYEE
  PAYEE
  EN_RETARD
  ANNULEE
}

enum UserJob {
  PLOMBIER_CHAUFFAGISTE
  ELECTRICIEN
  PEINTRE_BATIMENT
  MENUISIER
  AUTRE
}

enum WorkMode {
  SOLO
  TEAM
}

enum TeamRole {
  OWNER
  MANAGER
  TECHNICIAN
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id String @id @default(cuid())

  firstName String

  lastName String?

  companyName String?

  email String @unique

  emailVerifiedAt DateTime?

  phone String @unique

  passwordHash String

  trialEndsAt DateTime?

  subscriptionStatus String @default("TRIAL")

  job UserJob?

  workMode WorkMode?

  birthDate DateTime?

  onboardingCompleted Boolean @default(false)

  emailSignature String?

  themePreference String?

  clients Client[]

  interventions Intervention[]

  sessions Session[]

  passwordResetTokens PasswordResetToken[]

  accountActivationTokens AccountActivationToken[]

  memberships OrganizationMember[]

  assignedInterventions Intervention[] @relation("AssignedInterventions")

  sentTeamInvitations TeamInvitation[] @relation("InvitationSender")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  members       OrganizationMember[]
  invitations   TeamInvitation[]
  clients       Client[]
  interventions Intervention[]
  quotes        Quote[]
  invoices      Invoice[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  role           TeamRole
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model TeamInvitation {
  id             String               @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  role           TeamRole
  tokenHash      String               @unique
  expiresAt      DateTime
  status         TeamInvitationStatus @default(PENDING)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User                 @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Session {
  id String @id @default(cuid())

  token String @unique

  expiresAt DateTime

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id String @id @default(cuid())

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AccountActivationToken {
  id String @id @default(cuid())

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id String @id @default(cuid())

  type ClientType @default(PARTICULIER)

  firstName String?

  lastName String?

  companyName String?

  phone String?

  email String?

  street String?

  postalCode String?

  city String?

  notes String?

  // Client créé automatiquement par Forge lors d'une intervention
  // true = client temporaire
  // false = client enregistré normalement
  isTemporary Boolean @default(false)

  // Client masqué mais conservé pour l'historique
  // true = supprimé de l'affichage mais gardé en base
  archived Boolean @default(false)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  interventions Intervention[]

  quotes Quote[]

  invoices Invoice[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
}

model Intervention {
  id String @id @default(cuid())

  title String

  description String?

  // Date et heure de début prévue
  scheduledAt DateTime

  // Date de fin prévue (utile pour les chantiers longs)
  endDate DateTime?

  // Date réelle de début
  startedAt DateTime?

  // Date réelle de fin
  finishedAt DateTime?

  status InterventionStatus @default(PLANIFIEE)

  reportIntervention String?

  reportDiagnostic String?

  reportTravaux String?

  reportRecommendation String?

  invoices Invoice[]

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId String?

  assignedTo User? @relation("AssignedInterventions", fields: [assignedToId], references: [id], onDelete: SetNull)

  clientId String?

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([scheduledAt])
  @@index([endDate])
}

model Quote {
  id String @id @default(cuid())

  reference String @unique

  title String

  description String?

  amountCents Int @default(0)

  status QuoteStatus @default(BROUILLON)

  clientId String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  lines QuoteLine[]

  invoices Invoice[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([organizationId])
}

model QuoteLine {
  id String @id @default(cuid())

  category String

  label String?

  amountCents Int @default(0)

  quoteId String

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([quoteId])
}

model Invoice {
  id String @id @default(cuid())

  reference String @unique

  title String

  description String?

  amountCents Int @default(0)

  status InvoiceStatus @default(BROUILLON)

  dueDate DateTime?

  // Facture créée depuis un devis
  quoteId String?

  quote Quote? @relation(fields: [quoteId], references: [id])

  // Facture créée depuis une intervention terminée
  interventionId String?

  intervention Intervention? @relation(fields: [interventionId], references: [id])

  clientId String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([organizationId])
  @@index([quoteId])
  @@index([interventionId])
}
