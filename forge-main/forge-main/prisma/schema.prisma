generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientType {
  PARTICULIER
  PROFESSIONNEL
}

enum InterventionStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
}

enum QuoteAcceptanceMethod {
  CLIENT_LINK
}

enum QuoteSignatureMethod {
  DRAWN
}

enum QuoteReminderChannel {
  EMAIL
}

enum InvoiceStatus {
  BROUILLON
  ENVOYEE
  PAYEE
  EN_RETARD
  ANNULEE
}

enum InvoiceType {
  STANDARD
  DEPOSIT
  // Facturation à l'avancement d'un devis.
  SITUATION
  // Facture de solde : clôture la facturation d'un devis.
  BALANCE
}

enum CreditNoteStatus {
  BROUILLON
  EMISE
  ANNULEE
}

// FULL : avoir total, reprend toutes les lignes de la facture.
// PARTIAL : avoir partiel, lignes / montant choisis à la création.
enum CreditNoteMode {
  FULL
  PARTIAL
}

// Régime de TVA de l'organisation.
// SUBJECT : assujettie, elle facture la TVA.
// FRANCHISE_BASE : franchise en base (art. 293 B du CGI), aucune TVA facturée.
enum VatScheme {
  SUBJECT
  FRANCHISE_BASE
}

// Nature d'un document numéroté (compteur séquentiel séparé par nature).
enum DocumentKind {
  QUOTE
  INVOICE
  CREDIT_NOTE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

enum ServicePricingType {
  FIXED
  HOURLY
  UNIT
}

enum MaterialAnalysisStatus {
  PROCESSING
  NEEDS_INPUT
  COMPLETED
  FAILED
}

enum UserJob {
  PLOMBIER_CHAUFFAGISTE
  ELECTRICIEN
  PEINTRE_BATIMENT
  MENUISIER
  AUTRE
}

enum WorkMode {
  SOLO
  TEAM
}

enum OrganizationType {
  PERSONAL
  TEAM
}

enum TeamRole {
  OWNER
  ADMIN
  READ_ONLY

  // Rôles historiques conservés tant que leur présence en production
  // n'a pas pu être auditée.
  MANAGER
  TECHNICIAN
}

enum StaffRole {
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum InterventionExpenseCategory {
  MATERIALS
  SUPPLIES
  TRAVEL
  RENTAL
  SUBCONTRACTING
  OTHER
}

model User {
  id String @id @default(cuid())

  firstName String

  lastName String?

  companyName String?

  email String @unique

  emailVerifiedAt DateTime?

  phone String @unique

  passwordHash String

  trialStartedAt DateTime?

  trialEndsAt DateTime?

  subscriptionStatus String @default("TRIAL")

  job UserJob?

  workMode WorkMode?

  birthDate DateTime?

  onboardingCompleted Boolean @default(false)

  emailSignature String?

  themePreference String?

  smartRemindersEnabled Boolean @default(false)

  // Forcé à true quand un admin plateforme attribue un mot de passe temporaire.
  mustChangePassword Boolean @default(false)

  clients Client[]

  interventions Intervention[]

  sessions Session[]

  passwordResetTokens PasswordResetToken[]

  accountActivationTokens AccountActivationToken[]

  memberships OrganizationMember[]

  personalOrganization Organization? @relation("PersonalOrganizationOwner")

  assignedInterventions Intervention[] @relation("AssignedInterventions")

  interventionAssignments    InterventionAssignment[]
  interventionDayAssignments InterventionDayAssignment[]

  sentTeamInvitations TeamInvitation[] @relation("InvitationSender")

  staffMembership StaffMember?

  adminActions AdminAuditLog[] @relation("AdminAuditActor")

  quoteReminders QuoteReminder[] @relation("QuoteReminderCreator")

  invoiceReminders InvoiceReminder[] @relation("InvoiceReminderCreator")

  recordedPayments Payment[] @relation("PaymentRecorder")

  workTimeEntries InterventionWorkTime[]

  assignedInterventionTasks InterventionDayTask[] @relation("InterventionTaskAssignee")

  createdInterventionExpenses InterventionExpense[] @relation("InterventionExpenseCreator")
  materialAnalyses            MaterialAnalysis[]    @relation("MaterialAnalysisRequester")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model StaffMember {
  id     String    @id @default(cuid())
  userId String    @unique
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   StaffRole @default(SUPPORT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  // Ex : "USER_PASSWORD_RESET_EMAIL", "USER_UPDATED", "USER_DELETED",
  // "SUBSCRIPTION_CHANGED", "STAFF_GRANTED", "USER_DATA_EXPORTED".
  action String

  targetType String
  targetId   String

  summary  String?
  metadata Json?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}

model Organization {
  id                 String           @id @default(cuid())
  name               String
  type               OrganizationType @default(TEAM)
  personalOwnerId    String?          @unique
  personalOwner      User?            @relation("PersonalOrganizationOwner", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  subscriptionStatus String           @default("TRIAL")
  // Métiers activés pour suggérer le contenu pertinent de la bibliothèque.
  // Tableau extensible : un workspace peut exercer plusieurs métiers.
  tradeSlugs         String[]         @default([])

  // Posé quand tous les membres d'une équipe sont FREE : l'équipe est
  // supprimée passé cette date. Remis à null dès qu'un membre a un abonnement.
  graceExpiresAt             DateTime?
  // Régime de TVA par défaut de l'espace + taux par défaut (points de base :
  // 2000 = 20 %, 1000 = 10 %, 550 = 5,5 %, 0 = 0 %). Surchargeable par document.
  vatScheme                  VatScheme                   @default(FRANCHISE_BASE)
  defaultVatRateBp           Int                         @default(2000)
  // Préfixes de numérotation. Numéro final : <préfixe><année>-<6 chiffres>,
  // ex. F2026-000042. Compteur remis à zéro chaque année.
  quotePrefix                String                      @default("D")
  invoicePrefix              String                      @default("F")
  creditNotePrefix           String                      @default("AV")
  // Logo de l'entreprise (data URL PNG/JPEG), affiché en tête des PDF.
  logoDataUrl                String?
  // Identité de l'entreprise reprise en tête des devis / factures / avoirs.
  legalName                  String?
  siret                      String?
  vatNumber                  String?
  apeCode                    String?
  addressStreet              String?
  addressPostalCode          String?
  addressCity                String?
  contactPhone               String?
  contactEmail               String?
  // Cadence des relances automatiques (en jours), modifiable par l'artisan
  // dans Réglages > Relances. Devis : 2 niveaux. Factures : 3 niveaux.
  quoteReminderDelay1Days    Int                         @default(3)
  quoteReminderDelay2Days    Int                         @default(7)
  invoiceReminderDelay1Days  Int                         @default(7)
  invoiceReminderDelay2Days  Int                         @default(15)
  invoiceReminderDelay3Days  Int                         @default(30)
  // Si activé, la tâche planifiée (cron) envoie elle-même les relances
  // éligibles, sans validation humaine. Sinon (par défaut), Forge propose
  // seulement — l'artisan relit et envoie depuis la fiche du document.
  quoteReminderAutoSend      Boolean                     @default(false)
  invoiceReminderAutoSend    Boolean                     @default(false)
  documentCounters           DocumentCounter[]
  // Compte Stripe Connect (Express) de l'artisan pour encaisser en ligne.
  stripeAccountId            String?
  stripeChargesEnabled       Boolean                     @default(false)
  stripePayoutsEnabled       Boolean                     @default(false)
  stripeDetailsSubmitted     Boolean                     @default(false)
  stripeOnboardedAt          DateTime?
  payments                   Payment[]
  interventionWorkTimes      InterventionWorkTime[]
  interventionExpenses       InterventionExpense[]
  interventionMaterialUsages InterventionMaterialUsage[]
  interventionAssignments    InterventionAssignment[]
  interventionDayAssignments InterventionDayAssignment[]
  suppliers                  Supplier[]
  purchases                  Purchase[]
  purchaseLines              PurchaseLine[]
  purchaseAllocations        PurchaseAllocation[]
  members                    OrganizationMember[]
  invitations                TeamInvitation[]
  clients                    Client[]
  interventions              Intervention[]
  quotes                     Quote[]
  invoices                   Invoice[]
  creditNotes                CreditNote[]
  quoteTemplates             QuoteTemplate[]
  serviceCatalogItems        ServiceCatalogItem[]
  workspaceMaterials         WorkspaceMaterial[]
  workspaceMaterialImages    WorkspaceMaterialImage[]
  materialAnalyses           MaterialAnalysis[]
  activeSessions             Session[]                   @relation("ActiveOrganization")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCatalogItem {
  id                String                    @id @default(cuid())
  organizationId    String
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogServiceId  String?
  catalogService    ServiceCatalogDefinition? @relation(fields: [catalogServiceId], references: [id], onDelete: SetNull)
  name              String
  description       String?
  priceCents        Int
  pricingType       ServicePricingType
  lineType          String                    @default("SERVICE")
  category          String?
  unit              String                    @default("forfait")
  vatRateBp         Int                       @default(0)
  internalCostCents Int?
  tradeSlugs        String[]                  @default([])
  favorite          Boolean                   @default(false)
  active            Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([organizationId, catalogServiceId])
  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, lineType, active])
}

// Définition Forge globale, sans prix/coût interne propre à un artisan.
model ServiceCatalogDefinition {
  id                 String               @id @default(cuid())
  name               String
  description        String?
  category           String?
  lineType           String               @default("SERVICE")
  unit               String               @default("forfait")
  suggestedVatRateBp Int?
  tradeSlugs         String[]             @default([])
  tags               String[]             @default([])
  sourceType         String               @default("FORGE")
  sourceName         String?
  active             Boolean              @default(true)
  workspaceItems     ServiceCatalogItem[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([lineType, active])
  @@index([name])
}

model MaterialCategory {
  id        String                @id @default(cuid())
  name      String
  slug      String                @unique
  parentId  String?
  parent    MaterialCategory?     @relation("MaterialCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MaterialCategory[]    @relation("MaterialCategoryTree")
  active    Boolean               @default(true)
  position  Int                   @default(0)
  items     MaterialCatalogItem[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([parentId, position])
}

// Catalogue canonique Forge. Les références sont globales et ne contiennent
// jamais de données propres à un workspace.
model MaterialCatalogItem {
  id                         String                      @id @default(cuid())
  categoryId                 String?
  category                   MaterialCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name                       String
  brand                      String?
  reference                  String?
  description                String?
  specifications             Json?
  tags                       String[]                    @default([])
  tradeSlugs                 String[]                    @default([])
  suggestedVatRateBp         Int?
  sourceType                 String                      @default("FORGE")
  sourceName                 String?
  discontinuedAt             DateTime?
  unit                       String                      @default("u")
  defaultPurchasePriceCents  Int?
  defaultSalePriceCents      Int?
  supplier                   String?
  active                     Boolean                     @default(true)
  isFixture                  Boolean                     @default(false)
  workspaceMaterials         WorkspaceMaterial[]
  images                     MaterialCatalogImage[]
  quoteLines                 QuoteLine[]
  invoiceLines               InvoiceLine[]
  interventionMaterialUsages InterventionMaterialUsage[]
  purchaseLines              PurchaseLine[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@unique([brand, reference])
  @@index([categoryId, active])
  @@index([name])
  @@index([reference])
}

// Surcharge ou matériel personnalisé propre à l'espace actif.
model WorkspaceMaterial {
  id                         String                      @id @default(cuid())
  organizationId             String
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogItemId              String?
  catalogItem                MaterialCatalogItem?        @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  name                       String?
  brand                      String?
  reference                  String?
  description                String?
  specifications             Json?
  tags                       String[]                    @default([])
  unit                       String?
  purchasePriceCents         Int?
  salePriceCents             Int?
  supplier                   String?
  preferredSupplierId        String?
  preferredSupplier          Supplier?                   @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  favorite                   Boolean                     @default(false)
  active                     Boolean                     @default(true)
  quoteLines                 QuoteLine[]
  invoiceLines               InvoiceLine[]
  interventionMaterialUsages InterventionMaterialUsage[]
  purchaseLines              PurchaseLine[]
  images                     WorkspaceMaterialImage[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@unique([organizationId, catalogItemId])
  @@index([organizationId, active])
  @@index([organizationId, name])
  @@index([organizationId, reference])
  @@index([preferredSupplierId])
}

model Supplier {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  companyName        String?
  phone              String?
  email              String?
  address            String?
  website            String?
  accountReference   String?
  notes              String?
  active             Boolean             @default(true)
  purchases          Purchase[]
  preferredMaterials WorkspaceMaterial[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([organizationId, active])
  @@index([organizationId, name])
}

enum PurchaseStatus {
  ACTIVE
  VOIDED
}

model Purchase {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId       String?
  supplier         Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  interventionId   String?
  intervention     Intervention?         @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  purchasedAt      DateTime
  reference        String?
  supplierName     String?
  note             String?
  netAmountCents   Int
  vatAmountCents   Int
  totalAmountCents Int
  status           PurchaseStatus        @default(ACTIVE)
  lines            PurchaseLine[]
  allocations      PurchaseAllocation[]
  expenses         InterventionExpense[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([organizationId, purchasedAt])
  @@index([organizationId, supplierId])
  @@index([organizationId, interventionId])
}

model PurchaseLine {
  id                    String                      @id @default(cuid())
  purchaseId            String
  purchase              Purchase                    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  materialCatalogItemId String?
  materialCatalogItem   MaterialCatalogItem?        @relation(fields: [materialCatalogItemId], references: [id], onDelete: SetNull)
  workspaceMaterialId   String?
  workspaceMaterial     WorkspaceMaterial?          @relation(fields: [workspaceMaterialId], references: [id], onDelete: SetNull)
  lineType              String                      @default("MATERIAL")
  name                  String
  brand                 String?
  reference             String?
  quantityMilli         Int
  unit                  String                      @default("u")
  unitPriceCents        Int
  vatRateBp             Int                         @default(0)
  netAmountCents        Int
  vatAmountCents        Int
  totalAmountCents      Int
  supplierName          String?
  allocations           PurchaseAllocation[]
  materialUsages        InterventionMaterialUsage[]
  createdAt             DateTime                    @default(now())

  @@index([organizationId, materialCatalogItemId])
  @@index([organizationId, workspaceMaterialId])
  @@index([purchaseId])
}

model PurchaseAllocation {
  id              String                     @id @default(cuid())
  organizationId  String
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId      String
  purchase        Purchase                   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseLineId  String
  purchaseLine    PurchaseLine               @relation(fields: [purchaseLineId], references: [id], onDelete: Cascade)
  interventionId  String
  intervention    Intervention               @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  materialUsageId String?                    @unique
  materialUsage   InterventionMaterialUsage? @relation(fields: [materialUsageId], references: [id], onDelete: SetNull)
  quantityMilli   Int
  unitCostCents   Int
  amountCents     Int
  lineType        String                     @default("MATERIAL")
  createdAt       DateTime                   @default(now())

  @@index([organizationId, interventionId])
  @@index([purchaseLineId])
  @@index([purchaseId])
}

enum MaterialImageKind {
  PRODUCT
  DETAIL
  NAMEPLATE
  TECHNICAL
}

enum MaterialCatalogImageSourceType {
  MANUFACTURER
  AUTHORIZED_SUPPLIER
  AUTHORIZED_IMPORT
}

enum WorkspaceMaterialImageSourceType {
  WORKSPACE_UPLOAD
}

model MaterialCatalogImage {
  id                    String                         @id @default(cuid())
  materialCatalogItemId String
  materialCatalogItem   MaterialCatalogItem            @relation(fields: [materialCatalogItemId], references: [id], onDelete: Cascade)
  objectKey             String                         @unique
  kind                  MaterialImageKind              @default(PRODUCT)
  isPrimary             Boolean                        @default(false)
  position              Int                            @default(0)
  sourceType            MaterialCatalogImageSourceType
  sourceName            String?
  sourceUrl             String?
  license               String?
  rightsExpiresAt       DateTime?
  mimeType              String
  width                 Int
  height                Int
  checksum              String
  importedAt            DateTime                       @default(now())
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@unique([materialCatalogItemId, checksum])
  @@index([materialCatalogItemId, isPrimary, position])
}

model WorkspaceMaterialImage {
  id                  String                           @id @default(cuid())
  workspaceMaterialId String
  workspaceMaterial   WorkspaceMaterial                @relation(fields: [workspaceMaterialId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objectKey           String                           @unique
  kind                MaterialImageKind                @default(PRODUCT)
  isPrimary           Boolean                          @default(false)
  position            Int                              @default(0)
  sourceType          WorkspaceMaterialImageSourceType @default(WORKSPACE_UPLOAD)
  mimeType            String
  width               Int
  height              Int
  checksum            String
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@unique([workspaceMaterialId, checksum])
  @@index([organizationId, workspaceMaterialId])
  @@index([workspaceMaterialId, isPrimary, position])
}

// Trace structurée de l'analyse, sans conservation du fichier photo brut.
model MaterialAnalysis {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String?
  requestedBy    User?                  @relation("MaterialAnalysisRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  model          String
  status         MaterialAnalysisStatus @default(PROCESSING)
  photoCount     Int
  inputHash      String?
  result         Json?
  errorCode      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([organizationId, createdAt])
  @@index([requestedById, createdAt])
}

// Compteur séquentiel de numéros de documents, par organisation, par nature
// et par année. `nextNumber` est le prochain numéro à attribuer.
model DocumentCounter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           DocumentKind
  year           Int
  nextNumber     Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, kind, year])
}

model OrganizationMember {
  id              String       @id @default(cuid())
  role            TeamRole
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Coût interne par heure, utilisé uniquement pour la rentabilité.
  hourlyCostCents Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model TeamInvitation {
  id             String               @id @default(cuid())
  firstName      String?
  lastName       String?
  email          String
  role           TeamRole
  tokenHash      String               @unique
  expiresAt      DateTime
  status         TeamInvitationStatus @default(PENDING)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User                 @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Session {
  id String @id @default(cuid())

  token String @unique

  expiresAt DateTime

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  activeOrganization Organization? @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([activeOrganizationId])
}

model PasswordResetToken {
  id String @id @default(cuid())

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AccountActivationToken {
  id String @id @default(cuid())

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id String @id @default(cuid())

  type ClientType @default(PARTICULIER)

  firstName String?

  lastName String?

  companyName String?

  phone String?

  email String?

  street String?

  postalCode String?

  city String?

  notes String?

  // Client créé automatiquement par Forge lors d'une intervention
  // true = client temporaire
  // false = client enregistré normalement
  isTemporary Boolean @default(false)

  // Client masqué mais conservé pour l'historique
  // true = supprimé de l'affichage mais gardé en base
  archived Boolean @default(false)

  // Auteur historique conservé pour l'audit. Les données appartiennent à
  // l'organisation et survivent au départ d'un membre d'équipe.
  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  interventions Intervention[]

  quotes Quote[]

  invoices Invoice[]

  creditNotes CreditNote[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
}

model InterventionDayTask {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  // Journée calendaire stockée au début du jour Europe/Paris.
  // Null = tâche générale du chantier, affectable à une journée plus tard.
  date           DateTime?
  title          String
  description    String?
  startTime      String?
  endTime        String?
  completedAt    DateTime?
  startedAt      DateTime?
  // String volontairement extensible : TODO, IN_PROGRESS, DONE.
  status         String       @default("TODO")
  assignedToId   String?
  assignedTo     User?        @relation("InterventionTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  report         String?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([interventionId, date, position])
  @@index([assignedToId])
}

model InterventionAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([interventionId, userId])
  @@index([organizationId, userId])
}

model InterventionDayAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  date           DateTime
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([interventionId, date, userId])
  @@index([organizationId, userId, date])
}

model InterventionDayState {
  id               String       @id @default(cuid())
  interventionId   String
  intervention     Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  date             DateTime
  startedAt        DateTime?
  completedAt      DateTime?
  report           String?
  finalizationStep String?
  reportDraft      String?
  reportSkippedAt  DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([interventionId, date])
  @@index([interventionId, date])
}

model InterventionExcludedDay {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  date           DateTime
  createdAt      DateTime     @default(now())

  @@unique([interventionId, date])
  @@index([interventionId, date])
}

model InterventionWorkTime {
  id              String       @id @default(cuid())
  interventionId  String
  intervention    Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Journée Europe/Paris facultative du chantier.
  dayDate         DateTime?
  startedAt       DateTime
  endedAt         DateTime?
  // Figée à la fermeture ou à la saisie manuelle.
  durationMinutes Int?
  // Snapshot : une modification future du coût membre ne change pas l'historique.
  hourlyCostCents Int?
  manual          Boolean      @default(false)
  note            String?
  creationKey     String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([interventionId, dayDate])
  @@index([organizationId, userId])
}

model InterventionExpense {
  id              String                      @id @default(cuid())
  interventionId  String
  intervention    Intervention                @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId      String?
  purchase        Purchase?                   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdByUser   User                        @relation("InterventionExpenseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  dayDate         DateTime?
  amountCents     Int
  category        InterventionExpenseCategory @default(OTHER)
  supplier        String?
  description     String?
  note            String?
  creationKey     String?                     @unique
  expenseDate     DateTime
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([interventionId, expenseDate])
  @@index([organizationId])
  @@index([purchaseId])
}

model InterventionMaterialUsage {
  id                    String               @id @default(cuid())
  interventionId        String
  intervention          Intervention         @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dayDate               DateTime?
  materialCatalogItemId String?
  materialCatalogItem   MaterialCatalogItem? @relation(fields: [materialCatalogItemId], references: [id], onDelete: SetNull)
  workspaceMaterialId   String?
  workspaceMaterial     WorkspaceMaterial?   @relation(fields: [workspaceMaterialId], references: [id], onDelete: SetNull)
  purchaseLineId        String?
  purchaseLine          PurchaseLine?        @relation(fields: [purchaseLineId], references: [id], onDelete: SetNull)
  purchaseAllocation    PurchaseAllocation?
  name                  String
  brand                 String?
  reference             String?
  specifications        Json?
  quantityMilli         Int                  @default(1000)
  unit                  String               @default("u")
  actualUnitCostCents   Int?
  note                  String?
  creationKey           String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([interventionId, dayDate])
  @@index([organizationId])
  @@index([materialCatalogItemId])
  @@index([workspaceMaterialId])
  @@index([purchaseLineId])
}

model Intervention {
  id String @id @default(cuid())

  title String

  description String?

  // Date et heure de début prévue
  scheduledAt DateTime

  // Date de fin prévue (utile pour les chantiers longs)
  endDate DateTime?

  // Date réelle de début
  startedAt DateTime?

  // Date réelle de fin
  finishedAt DateTime?

  status InterventionStatus @default(PLANIFIEE)

  reportIntervention String?

  reportDiagnostic String?

  reportTravaux String?

  reportRecommendation String?

  // Progression administrative persistante après le travail sur le terrain.
  finalizationStep String?

  reportDraft String?

  reportSkippedAt DateTime?

  finalizedAt DateTime?

  quoteId String?

  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  invoices Invoice[]

  dayTasks            InterventionDayTask[]
  dayStates           InterventionDayState[]
  excludedDays        InterventionExcludedDay[]
  workTimes           InterventionWorkTime[]
  expenses            InterventionExpense[]
  materialUsages      InterventionMaterialUsage[]
  purchases           Purchase[]
  purchaseAllocations PurchaseAllocation[]
  assignments         InterventionAssignment[]
  dayAssignments      InterventionDayAssignment[]

  // Avancement explicite facultatif (0..10000). Null = progression dérivée.
  progressBp Int?

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId String?

  assignedTo User? @relation("AssignedInterventions", fields: [assignedToId], references: [id], onDelete: SetNull)

  clientId String?

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([scheduledAt])
  @@index([endDate])
  @@index([quoteId])
  @@index([organizationId, finalizedAt])
}

model Quote {
  id String @id @default(cuid())

  reference String @unique

  title String

  description String?

  // amountCents = total TTC (= total HT quand la TVA n'est pas applicable).
  amountCents Int @default(0)

  // TVA appliquée sur ce devis (surcharge le régime de l'organisation).
  vatApplicable Boolean @default(false)

  totalHtCents Int @default(0)

  totalVatCents Int @default(0)

  // Remise globale de pied de devis, en points de base (appliquée après les
  // remises de ligne, avant la TVA).
  discountBp Int @default(0)

  // Somme des déboursés secs des lignes (pour le calcul de marge).
  totalCostCents Int @default(0)

  // Retenue de garantie appliquée aux factures de ce devis, en points de
  // base (ex. 500 = 5 %). 0 = aucune retenue.
  retentionBp Int @default(0)

  status QuoteStatus @default(BROUILLON)

  acceptedAt DateTime?

  // Date du dernier envoi réussi du devis au client.
  sentAt DateTime?

  acceptanceMethod QuoteAcceptanceMethod?

  clientId String?

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  lines QuoteLine[]

  invoices Invoice[]

  publicAccesses QuotePublicAccess[]

  signature QuoteSignature?

  reminders QuoteReminder[]

  interventions Intervention[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([organizationId])
}

model QuoteReminder {
  id String @id @default(cuid())

  quoteId String

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  sentAt DateTime

  channel QuoteReminderChannel @default(EMAIL)

  createdByUserId String?

  createdByUser User? @relation("QuoteReminderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([quoteId, sentAt])
  @@index([createdByUserId])
}

enum InvoiceReminderChannel {
  EMAIL
}

model InvoiceReminder {
  id String @id @default(cuid())

  invoiceId String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sentAt DateTime

  channel InvoiceReminderChannel @default(EMAIL)

  createdByUserId String?

  createdByUser User? @relation("InvoiceReminderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId, sentAt])
  @@index([createdByUserId])
}

model QuotePublicAccess {
  id String @id @default(cuid())

  tokenHash String @unique

  quoteId String

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  signature QuoteSignature?

  revokedAt DateTime?

  acceptedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@index([quoteId, revokedAt])
}

model QuoteSignature {
  id String @id @default(cuid())

  quoteId String @unique

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  publicAccessId String @unique

  publicAccess QuotePublicAccess @relation(fields: [publicAccessId], references: [id], onDelete: Restrict)

  signerFirstName String

  signerLastName String

  method QuoteSignatureMethod @default(DRAWN)

  // V1 : traits manuscrits normalisés et limités. Un stockage objet pourra
  // remplacer cette représentation si Forge gère plus tard d'autres preuves.
  signatureData Json

  quoteSnapshot Json

  integrityHash String

  signedAt DateTime

  createdAt DateTime @default(now())

  @@index([signedAt])
}

model QuoteLine {
  id String @id @default(cuid())

  category String

  // Type métier extensible. String (et non enum) pour préserver les anciens
  // types et permettre d'en ajouter sans migration destructive.
  lineType String?

  label String?

  // Quantité en milliunités (1000 = 1 ; 12500 = 12,5).
  quantityMilli Int @default(1000)

  // Unité affichée : "forfait", "h", "j", "m2", "m3", "ml", "u", "kg", "lot".
  unit String @default("forfait")

  // Prix unitaire HT en centimes.
  unitPriceCents Int @default(0)

  // Déboursé sec unitaire en centimes (coût). Null = marge non suivie.
  costCents Int?

  // Remise de ligne en points de base (500 = 5 %).
  discountBp Int @default(0)

  // Montant HT de la ligne, dénormalisé :
  // round(quantityMilli * unitPriceCents / 1000 * (10000 - discountBp) / 10000).
  amountCents Int @default(0)

  // Taux de TVA de la ligne en points de base (2000 = 20 %, 1000 = 10 %,
  // 550 = 5,5 %, 0 = 0 %). Ignoré si le devis n'applique pas la TVA.
  vatRateBp Int @default(0)

  // Snapshot matériel : les documents historiques restent inchangés quand le
  // catalogue évolue. Les relations servent seulement à retrouver la source.
  materialCatalogItemId  String?
  materialCatalogItem    MaterialCatalogItem? @relation(fields: [materialCatalogItemId], references: [id], onDelete: SetNull)
  workspaceMaterialId    String?
  workspaceMaterial      WorkspaceMaterial?   @relation(fields: [workspaceMaterialId], references: [id], onDelete: SetNull)
  materialName           String?
  materialBrand          String?
  materialReference      String?
  materialSpecifications Json?
  materialSupplier       String?

  // Provenance informative d'un ouvrage/modèle, figée à l'insertion.
  sourceWorkTemplateId        String?
  sourceWorkTemplateName      String?
  sourceWorkTemplateVersionAt DateTime?

  quoteId String

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  details QuoteLineDetail[]

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([materialCatalogItemId])
  @@index([workspaceMaterialId])
}

model QuoteLineDetail {
  id             String    @id @default(cuid())
  label          String
  description    String?
  // Quantité × unité × PU HT du sous-détail. Sert uniquement à calculer
  // amountCents ci-dessous ; jamais inclus dans les totaux de la ligne.
  quantityMilli  Int       @default(1000)
  unit           String    @default("forfait")
  unitPriceCents Int?
  // Facultatif et uniquement informatif : jamais inclus dans les totaux.
  amountCents    Int?
  position       Int       @default(0)
  quoteLineId    String
  quoteLine      QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@index([quoteLineId, position])
}

model Invoice {
  id String @id @default(cuid())

  creationKey String? @unique

  reference String @unique

  title String

  description String?

  // amountCents = total TTC (= total HT quand la TVA n'est pas applicable).
  amountCents Int @default(0)

  vatApplicable Boolean @default(false)

  totalHtCents Int @default(0)

  totalVatCents Int @default(0)

  // Remise globale de pied de facture, en points de base.
  discountBp Int @default(0)

  // Somme des déboursés secs des lignes (pour le calcul de marge).
  totalCostCents Int @default(0)

  lines InvoiceLine[]

  // Encaissement.
  paidAt        DateTime?
  paymentMethod String?

  payments       Payment[]
  publicAccesses InvoicePublicAccess[]
  creditNotes    CreditNote[]

  status InvoiceStatus @default(BROUILLON)

  // STANDARD pour les factures historiques/finales, DEPOSIT pour un acompte,
  // SITUATION pour une facturation à l'avancement, BALANCE pour le solde.
  type InvoiceType @default(STANDARD)

  // SITUATION uniquement : avancement cumulé du devis facturé par cette
  // situation, en points de base (ex. 6000 = 60 %).
  situationProgressBp Int?

  // Retenue de garantie retenue sur cette facture, en centimes. Le client
  // règle amountCents − retentionCents ; la retenue est libérée plus tard.
  retentionCents Int @default(0)

  dueDate DateTime?

  // Date du dernier envoi réussi de la facture au client (relances).
  sentAt DateTime?

  reminders InvoiceReminder[]

  // Facture créée depuis un devis
  quoteId String?

  quote Quote? @relation(fields: [quoteId], references: [id])

  // Facture créée depuis une intervention terminée
  interventionId String?

  intervention Intervention? @relation(fields: [interventionId], references: [id])

  clientId String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([organizationId])
  @@index([quoteId])
  @@index([quoteId, type])
  @@index([interventionId])
}

// Paiement d'une facture. Une facture peut en avoir plusieurs (partiels,
// relances, remboursements). Le statut PAYEE de la facture est dérivé de la
// somme des paiements SUCCEEDED (moins les remboursements).
model Payment {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  amountCents   Int
  // Frais du prestataire (Stripe). netCents = amountCents - feeCents.
  feeCents      Int    @default(0)
  netCents      Int    @default(0)
  refundedCents Int    @default(0)
  currency      String @default("eur")

  status       PaymentStatus   @default(PENDING)
  provider     PaymentProvider @default(MANUAL)
  // "card" | "bank_transfer" | "virement" | "cheque" | "especes"
  method       String?
  reference    String?
  errorMessage String?

  stripePaymentIntentId   String? @unique
  stripeCheckoutSessionId String? @unique

  recordedByUserId String?
  recordedByUser   User?   @relation("PaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([invoiceId])
  @@index([organizationId])
  @@index([status])
}

// Idempotence des webhooks Stripe : un event n'est traité qu'une fois.
model StripeEvent {
  id         String   @id
  type       String
  accountId  String?
  receivedAt DateTime @default(now())
}

// Lien public tokenisé d'une facture (page de règlement client), sur le
// modèle de QuotePublicAccess.
model InvoicePublicAccess {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  revokedAt DateTime?
  viewedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([invoiceId])
  @@index([invoiceId, revokedAt])
}

model InvoiceLine {
  id String @id @default(cuid())

  category String

  lineType String?

  label String?

  // Détail figé à la création de la facture.
  quantityMilli Int @default(1000)

  unit String @default("forfait")

  unitPriceCents Int @default(0)

  costCents Int?

  discountBp Int @default(0)

  // Montant HT de la ligne, figé à la création de la facture.
  amountCents Int @default(0)

  // Taux de TVA de la ligne en points de base. Ignoré si la facture
  // n'applique pas la TVA.
  vatRateBp Int @default(0)

  materialCatalogItemId  String?
  materialCatalogItem    MaterialCatalogItem? @relation(fields: [materialCatalogItemId], references: [id], onDelete: SetNull)
  workspaceMaterialId    String?
  workspaceMaterial      WorkspaceMaterial?   @relation(fields: [workspaceMaterialId], references: [id], onDelete: SetNull)
  materialName           String?
  materialBrand          String?
  materialReference      String?
  materialSpecifications Json?
  materialSupplier       String?

  sourceWorkTemplateId        String?
  sourceWorkTemplateName      String?
  sourceWorkTemplateVersionAt DateTime?

  invoiceId String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  details InvoiceLineDetail[]

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([materialCatalogItemId])
  @@index([workspaceMaterialId])
}

model InvoiceLineDetail {
  id             String      @id @default(cuid())
  label          String
  description    String?
  // Quantité × unité × PU HT du sous-détail. Sert uniquement à calculer
  // amountCents ci-dessous ; jamais inclus dans les totaux de la ligne.
  quantityMilli  Int         @default(1000)
  unit           String      @default("forfait")
  unitPriceCents Int?
  // Facultatif et uniquement informatif : jamais inclus dans les totaux.
  amountCents    Int?
  position       Int         @default(0)
  invoiceLineId  String
  invoiceLine    InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@index([invoiceLineId, position])
}

// Avoir (note de crédit) rattaché à une facture émise. Réduit le montant
// effectivement dû par le client. Numéro définitif attribué à l'émission.
model CreditNote {
  id String @id @default(cuid())

  creationKey String? @unique

  reference String @unique

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  mode   CreditNoteMode   @default(PARTIAL)
  status CreditNoteStatus @default(BROUILLON)

  // Motif de l'avoir (obligatoire à l'émission).
  reason String?

  // Totaux figés, cohérents avec le régime de TVA de la facture d'origine.
  vatApplicable Boolean @default(false)
  amountCents   Int     @default(0)
  totalHtCents  Int     @default(0)
  totalVatCents Int     @default(0)
  discountBp    Int     @default(0)

  lines CreditNoteLine[]

  issuedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([invoiceId])
  @@index([organizationId])
  @@index([clientId])
}

model CreditNoteLine {
  id String @id @default(cuid())

  category            String
  lineType            String?
  sourceInvoiceLineId String?
  label               String?

  quantityMilli  Int    @default(1000)
  unit           String @default("forfait")
  unitPriceCents Int    @default(0)
  discountBp     Int    @default(0)
  amountCents    Int    @default(0)
  vatRateBp      Int    @default(0)

  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([creditNoteId])
}

// Modèle de devis réutilisable : titre, réglages et lignes types.
model QuoteTemplate {
  id             String        @id @default(cuid())
  // Null = ouvrage Forge global ; renseigné = ouvrage propre au workspace.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  title            String
  description      String?
  category         String?
  tradeSlugs       String[]        @default([])
  favorite         Boolean         @default(false)
  active           Boolean         @default(true)
  // Filiation informative d'une copie personnalisée. Le contenu reste figé.
  sourceTemplateId String?
  sourceTemplate   QuoteTemplate?  @relation("QuoteTemplateCopies", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies           QuoteTemplate[] @relation("QuoteTemplateCopies")

  vatApplicable Boolean @default(false)
  discountBp    Int     @default(0)
  retentionBp   Int     @default(0)

  lines QuoteTemplateLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, active])
  @@index([sourceTemplateId])
}

model QuoteTemplateLine {
  id String @id @default(cuid())

  category String
  lineType String?
  label    String?

  quantityMilli  Int    @default(1000)
  unit           String @default("forfait")
  unitPriceCents Int    @default(0)
  costCents      Int?
  discountBp     Int    @default(0)
  vatRateBp      Int    @default(0)
  position       Int    @default(0)

  materialCatalogItemId  String?
  workspaceMaterialId    String?
  materialName           String?
  materialBrand          String?
  materialReference      String?
  materialSpecifications Json?
  materialSupplier       String?

  details QuoteTemplateLineDetail[]

  templateId String
  template   QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([templateId, position])
}

model QuoteTemplateLineDetail {
  id             String            @id @default(cuid())
  label          String
  description    String?
  quantityMilli  Int               @default(1000)
  unit           String            @default("forfait")
  unitPriceCents Int?
  amountCents    Int?
  position       Int               @default(0)
  templateLineId String
  templateLine   QuoteTemplateLine @relation(fields: [templateLineId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([templateLineId, position])
}
